    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5"
  }
}
