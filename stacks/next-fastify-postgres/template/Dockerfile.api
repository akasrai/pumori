# API image: runs the TypeScript sources directly with Node 22 type stripping (no build step).
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --filter @app/api...

FROM node:22-slim AS runtime
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=deps --chown=node:node /repo/package.json ./package.json
COPY --from=deps --chown=node:node /repo/node_modules ./node_modules
COPY --from=deps --chown=node:node /repo/packages/shared ./packages/shared
COPY --from=deps --chown=node:node /repo/apps/api ./apps/api
USER node
WORKDIR /repo/apps/api
EXPOSE 4000
# Deploy-time migrations use this same image, run once before the new version starts:
#   docker run --rm -e DATABASE_URL=... <image> node --disable-warning=ExperimentalWarning src/db/migrate.ts
# (compose.staging.yml does this as its one-shot `migrate` service).
CMD ["node", "--disable-warning=ExperimentalWarning", "src/server.ts"]
