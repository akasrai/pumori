{
  "name": "app-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/shared --noEmit && pnpm --filter @app/web typecheck && pyright -p apps/api",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "pyright": "^1.1.405",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
