# Copied to .env by ./init.sh (or ./verify) on first run. .env is gitignored.
# Every variable is validated by apps/api/app/settings.py; see README.md for what production needs.
PROJECT={{PROJECT}}
DB_NAME={{DB_NAME}}
# The Postgres role "DB_USER" is replaced by $DB_USER or $(whoami) when .env is created.
DATABASE_URL=postgres://DB_USER@localhost:5432/{{DB_NAME}}
API_PORT={{API_PORT}}
WEB_PORT={{WEB_PORT}}
# Public URL of the web app; links in emails use it. Required (https) in production.
WEB_ORIGIN=http://localhost:{{WEB_PORT}}
# init.sh replaces change-me with a random 64-char hex secret.
SESSION_SECRET=change-me
# Must be true in production (https). NODE_ENV=production refuses false unless ALLOW_INSECURE_COOKIES=true.
COOKIE_SECURE=false
LOG_LEVEL=info

# Optional (defaults shown):
# TRUST_PROXY=false            # hop count (1 = behind the web /api rewrite or one load balancer) or IP/CIDR list
# DB_POOL_MAX=10               # Postgres connections per API process
# DB_STATEMENT_TIMEOUT_MS=10000
# RATE_LIMIT_MAX=300           # requests per IP per minute
# RATE_LIMIT_AUTH_MAX=20       # logins and signups per IP per 15 minutes
# RATE_LIMIT_LOGIN_EMAIL_MAX=10  # logins per email per 15 minutes
# MAIL_TRANSPORT=dev           # dev (in-memory outbox at /dev/mail) outside production, log in production
