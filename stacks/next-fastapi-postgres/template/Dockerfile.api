# API image: Python 3.13 + the locked dependencies (uv), running as a non-root user.
FROM python:3.13-slim AS deps
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project

FROM python:3.13-slim AS runtime
ENV APP_ENV=production PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/app/.venv/bin:$PATH
RUN useradd --system --uid 10001 app
WORKDIR /app
COPY --from=deps /app/.venv ./.venv
COPY --chown=app:app apps/api/app ./app
COPY --chown=app:app apps/api/migrations ./migrations
COPY --chown=app:app apps/api/alembic.ini ./alembic.ini
USER app
EXPOSE 4000
# Deploy-time migrations use this same image, run once before the new version starts:
#   docker run --rm -e DATABASE_URL=... <image> alembic -c alembic.ini upgrade head
# (compose.staging.yml does this as its one-shot `migrate` service).
CMD ["python", "-m", "app.server"]
